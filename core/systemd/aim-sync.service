[Unit]
Description=A.I.M. Calendar Background Sync Service (rclone + incremental ingestion)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/aim-calendar
ExecStart=/bin/bash %h/aim-calendar/core/sync_daemon.sh --once
StandardOutput=append:%h/aim-calendar/sync_daemon.log
StandardError=append:%h/aim-calendar/sync_daemon.log

[Install]
WantedBy=default.target
